import torch
import torch.nn as nn
import torch.optim as optim


# --- Создаём фейковые данные ---
X = torch.rand(16, 3, 224, 224)   # 16 изображений 224x224
y = torch.randint(0, 2, (16,))    # классы 0 или 1


# --- Модель ---
model = ResNet152Model(num_classes=2, mode="classification")

criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model.parameters(), lr=1e-4)


# --- Один шаг обучения ---
model.train()
optimizer.zero_grad()

pred = model(X)       # (16, 2)
loss = criterion(pred, y)

loss.backward()
optimizer.step()

print("Loss:", loss.item())
