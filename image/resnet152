import torch
import torch.nn as nn
from torchvision.models import resnet152, ResNet152_Weights


class ResNet152Model(nn.Module):
    def __init__(self, num_classes=10, pretrained=True, mode="classification"):
        """
        mode: "classification" или "regression"
        - classification → CrossEntropyLoss
        - regression → MSELoss, L1Loss
        """
        super().__init__()

        # Загружаем ResNet152
        if pretrained:
            self.model = resnet152(weights=ResNet152_Weights.IMAGENET1K_V2)
        else:
            self.model = resnet152(weights=None)

        in_features = self.model.fc.in_features

        # --- HEAD ---
        if mode == "classification":
            # 🔥 Классификация (заменяем последний слой)
            self.model.fc = nn.Linear(in_features, num_classes)

        elif mode == "regression":
            # 🔥 Регрессия (пример: 1 число или вектор)
            self.model.fc = nn.Sequential(
                nn.Linear(in_features, 512),
                nn.ReLU(),
                nn.Dropout(0.2),
                nn.Linear(512, num_classes),  # num_classes = размер выхода
            )

        self.mode = mode

    def forward(self, x):
        return self.model(x)


# ===== ПРИМЕР СОЗДАНИЯ =====

# ✔️ Классификация (например, 10 классов)
model_cls = ResNet152Model(num_classes=10, mode="classification")

