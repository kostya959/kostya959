import torch
import torch.nn as nn
from transformers import BertModel, BertTokenizer, BertConfig


class BertModelCustom(nn.Module):
    def __init__(self, num_classes=2, mode="classification", pretrained=True):
        """
        mode:
            - "classification"
            - "regression"
        """
        super().__init__()

        if pretrained:
            self.bert = BertModel.from_pretrained("bert-base-uncased")
        else:
            self.bert = BertModel(BertConfig())

        hidden = self.bert.config.hidden_size  # 768

        if mode == "classification":
            self.head = nn.Linear(hidden, num_classes)

        elif mode == "regression":
            self.head = nn.Sequential(
                nn.Linear(hidden, 256),
                nn.ReLU(),
                nn.Dropout(0.2),
                nn.Linear(256, num_classes),
            )

        self.mode = mode

    def forward(self, input_ids, attention_mask, token_type_ids=None):
        out = self.bert(
            input_ids=input_ids,
            attention_mask=attention_mask,
            token_type_ids=token_type_ids,
        )
        cls = out.last_hidden_state[:, 0, :]  # CLS token
        return self.head(cls)
class TextDataset(torch.utils.data.Dataset):
    def __init__(self, texts, labels, tokenizer, max_len=128):
        self.texts = texts
        self.labels = labels
        self.tokenizer = tokenizer
        self.max_len = max_len

    def __len__(self):
        return len(self.texts)

    def __getitem__(self, idx):
        item = self.tokenizer(
            self.texts[idx],
            max_length=self.max_len,
            padding='max_length',
            truncation=True,
            return_tensors="pt"
        )

        # item — словарь тензоров 1×L, поэтому squeeze
        item = {k: v.squeeze(0) for k, v in item.items()}

        if isinstance(self.labels[idx], torch.Tensor):
            label = self.labels[idx]
        else:
            label = torch.tensor(self.labels[idx])

        item["labels"] = label
        return item
def train_epoch(model, loader, optimizer, criterion, device):
    model.train()
    total_loss = 0

    for batch in loader:
        batch = {k: v.to(device) for k, v in batch.items()}
        
        optimizer.zero_grad()
        pred = model(
            input_ids=batch["input_ids"],
            attention_mask=batch["attention_mask"]
        )
        loss = criterion(pred, batch["labels"])
        loss.backward()
        optimizer.step()

        total_loss += loss.item()

    return total_loss / len(loader)


def eval_epoch(model, loader, criterion, device):
    model.eval()
    total_loss = 0

    with torch.no_grad():
        for batch in loader:
            batch = {k: v.to(device) for k, v in batch.items()}
            
            pred = model(
                input_ids=batch["input_ids"],
                attention_mask=batch["attention_mask"]
            )
            loss = criterion(pred, batch["labels"])
            total_loss += loss.item()

    return total_loss / len(loader)
def train_model(model, train_loader, val_loader, epochs, lr, device, is_reg=False):
    optimizer = torch.optim.Adam(model.parameters(), lr=lr)
    criterion = nn.MSELoss() if is_reg else nn.CrossEntropyLoss()

    model = model.to(device)

    for epoch in range(1, epochs + 1):
        train_loss = train_epoch(model, train_loader, optimizer, criterion, device)
        val_loss = eval_epoch(model, val_loader, criterion, device)

        print(f"Epoch {epoch}/{epochs}")
        print(f"  train loss: {train_loss:.4f}")
        print(f"  valid loss: {val_loss:.4f}")

    return model
tokenizer = BertTokenizer.from_pretrained("bert-base-uncased")

texts = [
    "Hello!", "Hi!", 
    "This is a very long sample sentence text that is long.",
    "Another long text example for classification"
]

labels = torch.tensor([0, 0, 1, 1])

train_ds = TextDataset(texts, labels, tokenizer)
train_loader = torch.utils.data.DataLoader(train_ds, batch_size=2, shuffle=True)

model = BertModelCustom(num_classes=2, mode="classification")
device = "cuda" if torch.cuda.is_available() else "cpu"

model = train_model(
    model=model,
    train_loader=train_loader,
    val_loader=train_loader,   # для демонстрации
    epochs=3,
    lr=2e-5,
    device=device,
    is_reg=False
)

def predict(model, texts, tokenizer, device):
    model.eval()
    encoded = tokenizer(
        texts, padding=True, truncation=True, return_tensors="pt"
    ).to(device)

    with torch.no_grad():
        logits = model(encoded["input_ids"], encoded["attention_mask"])

    if model.mode == "classification":
        return torch.softmax(logits, dim=1).argmax(1).cpu()

    else:  # regression
        return logits.cpu()


preds = predict(model, ["Test sentence here"], tokenizer, device)
print("Pred:", preds)

